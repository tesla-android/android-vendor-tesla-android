on zygote-start
    # Create directories for lighttpd logs
    mkdir /data/vendor/tesla-android
    mkdir /data/vendor/tesla-android/lighttpd
    mkdir /data/vendor/tesla-android/udev
    # Create directories OTA updates
    mkdir /data/vendor/tesla-android/ota 0770 system cache encryption=Require
    mkdir /data/vendor/tesla-android/bootFiles

service updateBootFiles /system/bin/sh /vendor/etc/updateBootFiles.sh
     user root 
     group root
     seclabel u:r:init:s0
     disabled
     oneshot

service preinstall /system/bin/sh /vendor/etc/preinstall.sh
     user root
     group root
     seclabel u:r:init:s0
     disabled
     oneshot

service lighttpd /vendor/bin/lighttpd -f /vendor/tesla-android/lighttpd/lighttpd.conf -D
     user root
     group root
     seclabel u:r:init:s0
     disabled

service tesla-android-configuration-manager /system/bin/tesla-android-configuration-manager
    user root
    group root
    seclabel u:r:init:s0
    disabled

service tesla-android-virtual-display /system/bin/tesla-android-virtual-display
    user root
    group root
    seclabel u:r:init:s0
    disabled

service tesla-android-virtual-touchscreen /system/bin/tesla-android-virtual-touchscreen
    user root
    group root
    seclabel u:r:init:s0
    disabled

service tesla-android-virtual-gnss /system/bin/tesla-android-virtual-gnss
    user root
    group root
    seclabel u:r:init:s0
    disabled
    
service tesla-android-usb-networking-initialiser /system/bin/tesla-android-usb-networking-initialiser
    user root
    group root
    seclabel u:r:init:s0
    disabled    

service tesla-android-audio-relay /vendor/bin/tesla-android-audio-relay
    class main
    user system
    group system
    socket ws_audio stream 0666 system system
    seclabel u:r:audioserver:s0
    disabled
    
service tesla-android-mic-bridge /vendor/bin/tesla-android-mic-bridge 9997 2
    class main
    user system
    group system audio inet
    seclabel u:r:init:s0
    disabled

service usbmuxd /system/bin/usbmuxd -vv -f -n -z
    user root
    group root
    seclabel u:r:init:s0
    disabled    

on property:sys.boot_completed=1
    # Network sysctls (increase TCP socket buffer limits / improve download throughput)
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/rmem_default 524288
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/core/wmem_default 524288
    write /proc/sys/net/ipv4/tcp_rmem "4096 262144 8388608"
    write /proc/sys/net/ipv4/tcp_wmem "4096 65536 8388608"
    write /proc/sys/net/ipv4/tcp_moderate_rcvbuf 1
    write /proc/sys/net/ipv4/tcp_window_scaling 1
    start updateBootFiles
    start usbmuxd
    start tesla-android-configuration-manager
    start tesla-android-usb-networking-initialiser
    start tesla-android-virtual-touchscreen
    start tesla-android-virtual-display
    start tesla-android-virtual-gnss
    start tesla-android-audio-relay
    start lighttpd
    start preinstall

# Browser microphone (opt-in): Tesla browser mic -> ALSA Loopback -> audio HAL input.
# Only on products that select the matching HAL (rpi4, cm4). The Loopback module is loaded
# here, so nothing changes until the feature is enabled.
on property:sys.boot_completed=1 && property:persist.tesla-android.browser_mic.is_enabled=1 && property:ro.hardware.audio.primary=tesla_android
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules snd-aloop pcm_substreams=1
    start tesla-android-mic-bridge

on property:persist.tesla-android.browser_mic.is_enabled=0
    stop tesla-android-mic-bridge
